# Patched Redash image with security updates
# This Dockerfile updates system packages and Python packages to fix vulnerabilities
# Using 25.8.0 for latest features + security patches
FROM redash/redash:25.8.0

USER root

# Update all system packages to patch OS-level vulnerabilities
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Update critical Python packages to patch application-level vulnerabilities
# h11: CVE-2025-43859 - requires >= 0.16.0
# setuptools: Multiple CVEs - requires >= 65.5.1
# wheel: CVE-2025-43860 - requires >= 0.46.2
RUN pip3 install --no-cache-dir --upgrade \
    'h11>=0.16.0' \
    'setuptools>=65.5.1' \
    'wheel>=0.46.2'

# Switch back to redash user
USER redash

# Keep the same entrypoint and cmd from the base image
ENTRYPOINT ["/app/bin/docker-entrypoint"]
CMD ["server"]
